---
import BaseLayout from '../layouts/BaseLayout.astro';
import FilterPanel from '../components/FilterPanel';
---
<BaseLayout title="審議一覧 - 国会議事録リアルタイムDB">
  <h1>審議一覧</h1>
  <p class="subtitle">院・日付・委員会・政党・発言者・役割・トピックで絞り込めます</p>
  <FilterPanel client:load />
</BaseLayout>

<style>
  h1 { font-size: 1.5rem; margin-bottom: 0.25rem; }
  .subtitle { color: #6b7280; font-size: 0.9rem; margin-bottom: 1.25rem; }
</style>
