---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchUI from '../components/SearchUI';
---

<BaseLayout title="検索 - 国会議事録リアルタイムDB">
  <h1>全文検索</h1>
  <p class="search-hint">
    <strong>スペース区切りでAND検索</strong>（例: <code>予算 委員会</code>）。話者名や委員会名も検索対象です。
    検索結果をクリックすると該当発言に直接ジャンプします。
  </p>
  <SearchUI client:load />
</BaseLayout>

<style>
  h1 { font-size: 1.5rem; margin-bottom: 0.5rem; }
  .search-hint {
    font-size: 0.85rem;
    color: #6b7280;
    margin-bottom: 1rem;
    line-height: 1.6;
  }
  .search-hint code {
    background: #f1f5f9;
    padding: 0.1rem 0.3rem;
    border-radius: 3px;
    font-size: 0.8rem;
  }
</style>
