---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---
<BaseLayout title="検索 - 国会議事録リアルタイムDB">
  <h1>全文検索</h1>
  <div id="search"></div>

  <link href={base + '/pagefind/pagefind-ui.css'} rel="stylesheet" />
  <link rel="modulepreload" href={base + '/pagefind/pagefind-ui.js'} />
  <script define:vars={{ base }}>
    // Pagefind UIをロード（ビルド後にdist/pagefind/に生成される）
    window.addEventListener('load', async () => {
      const { PagefindUI } = await import(base + '/pagefind/pagefind-ui.js');
      new PagefindUI({
        element: '#search',
        showSubResults: true,
        translations: {
          placeholder: '審議内容を検索...',
          zero_results: '「[SEARCH_TERM]」に一致する結果はありません',
        },
      });
    });
  </script>
</BaseLayout>

<style>
  h1 { font-size: 1.5rem; margin-bottom: 1rem; }
</style>
