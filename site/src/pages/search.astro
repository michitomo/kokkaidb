---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---
<BaseLayout title="検索 - 国会議事録リアルタイムDB">
  <h1>全文検索</h1>
  <div id="search"></div>

  <link href={base + '/pagefind/pagefind-ui.css'} rel="stylesheet" />
  <script is:inline src={base + '/pagefind/pagefind-ui.js'}></script>
  <script define:vars={{ base }}>
    window.addEventListener('DOMContentLoaded', () => {
      new window.PagefindUI({
        element: '#search',
        showSubResults: true,
        translations: {
          placeholder: '審議内容を検索...',
          zero_results: '「[SEARCH_TERM]」に一致する結果はありません',
        },
      });
    });
  </script>
</BaseLayout>

<style>
  h1 { font-size: 1.5rem; margin-bottom: 1rem; }
</style>
