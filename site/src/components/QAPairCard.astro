---
import type { QAPair, SessionMetadata } from '../lib/data';

interface Props {
  pair: QAPair;
  session?: SessionMetadata;
}

const { pair, session } = Astro.props;
const score = pair.answer.evasion_score;
const evasionColor = score < 0.3 ? '#16a34a' : score < 0.7 ? '#d97706' : '#dc2626';
const evasionLabel = score < 0.3 ? '低' : score < 0.7 ? '中' : '高';

// 動画タイムスタンプを "M:SS〜" 形式に変換
function formatVideoTime(videoUrl: string): string | null {
  const shugiinMatch = videoUrl.match(/[?&]time=(\d+)/);
  const sangiinMatch = videoUrl.match(/#(\d+)$/);
  const seconds = shugiinMatch
    ? parseInt(shugiinMatch[1], 10)
    : sangiinMatch
      ? parseInt(sangiinMatch[1], 10)
      : null;
  if (seconds === null) return null;
  const m = Math.floor(seconds / 60);
  const s = seconds % 60;
  return `${m}:${String(s).padStart(2, '0')}〜`;
}

const videoTime = pair.video_url ? formatVideoTime(pair.video_url) : null;
const videoTitle = videoTime ? `動画を見る（${videoTime}）` : '動画を見る';
const chamberName = session?.chamber === 'shugiin' ? '衆議院TV' : session?.chamber === 'sangiin' ? '参議院TV' : null;
---
<div class="qa-card">
  <div class="qa-header">
    <span class="topic">{pair.topic}</span>
    {pair.video_url && (
      <a
        class="video-link"
        href={pair.video_url}
        target="_blank"
        rel="noopener noreferrer"
        title={videoTitle}
      >
        ▶ 動画{videoTime ? `（${videoTime}）` : ''}
      </a>
    )}
  </div>

  <div class="qa-columns">
    <div class="question">
      <div class="speaker-label">
        質問 — <strong>{pair.question.speaker}</strong>
        {pair.question.party && <span class="party">（{pair.question.party}）</span>}
      </div>
      <p class="summary">{pair.question.summary}</p>
    </div>

    <div class="answer">
      <div class="speaker-label">
        答弁 — <strong>{pair.answer.speaker}</strong>
        {pair.answer.role && <span class="role">（{pair.answer.role}）</span>}
      </div>
      <p class="summary">{pair.answer.summary}</p>
      <div class="evasion" style={`color: ${evasionColor}`}>
        回避度 {evasionLabel}（{(score * 100).toFixed(0)}%）
      </div>
      {pair.answer.has_commitment && pair.answer.commitment_text && (
        <div class="commitment">
          <span class="commitment-label">約束:</span> {pair.answer.commitment_text}
        </div>
      )}
    </div>
  </div>

  {session && chamberName && (
    <div class="qa-source">
      出典:{' '}
      <a
        href={session.source_url}
        target="_blank"
        rel="noopener noreferrer"
        class="source-link"
      >
        {chamberName}インターネット審議中継
      </a>
    </div>
  )}
</div>

<style>
  .qa-card {
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    background: #fff;
    margin-bottom: 1rem;
    overflow: hidden;
  }
  .qa-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 1rem;
    background: #f8fafc;
    border-bottom: 1px solid #e5e7eb;
    font-size: 0.85rem;
  }
  .topic {
    font-weight: 600;
    color: #374151;
  }
  .video-link {
    color: #2563eb;
    text-decoration: none;
    font-size: 0.8rem;
  }
  .video-link:hover { text-decoration: underline; }
  .qa-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
  }
  @media (max-width: 640px) {
    .qa-columns { grid-template-columns: 1fr; }
  }
  .question, .answer {
    padding: 1rem;
  }
  .question {
    border-right: 1px solid #e5e7eb;
  }
  @media (max-width: 640px) {
    .question {
      border-right: none;
      border-bottom: 1px solid #e5e7eb;
    }
  }
  .speaker-label {
    font-size: 0.85rem;
    color: #6b7280;
    margin-bottom: 0.4rem;
  }
  .speaker-label strong { color: #111; }
  .party, .role { color: #6b7280; }
  .summary {
    margin: 0 0 0.5rem;
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .evasion {
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 0.4rem;
  }
  .commitment {
    font-size: 0.8rem;
    background: #f0fdf4;
    border-left: 3px solid #16a34a;
    padding: 0.4rem 0.6rem;
    margin-top: 0.4rem;
    color: #166534;
    line-height: 1.4;
  }
  .commitment-label { font-weight: 600; }
  .qa-source {
    padding: 0.4rem 1rem;
    background: #f8fafc;
    border-top: 1px solid #e5e7eb;
    font-size: 0.75rem;
    color: #9ca3af;
  }
  .source-link {
    color: #9ca3af;
    text-decoration: none;
  }
  .source-link:hover {
    text-decoration: underline;
    color: #6b7280;
  }
</style>
