---
import type { QAPair, SessionMetadata } from '../lib/data';

interface Props {
  pair: QAPair;
  session?: SessionMetadata;
  segmentFullTextDuplicate?: boolean;
}

const { pair, session } = Astro.props;
const segmentDup = Astro.props.segmentFullTextDuplicate ?? false;

// --- 新指標 ---
const completeness = pair.answer.answer_completeness ?? (pair.answer.evasion_score != null ? 1 - pair.answer.evasion_score : 0.5);
const commitStrength = pair.answer.commitment_strength ?? (pair.answer.has_commitment ? 0.5 : 0.0);
const recordVal = pair.record_value ?? 0.5;
const qSharpness = pair.question.question_sharpness ?? 0.5;
const evGrounding = pair.question.evidence_grounding ?? 0.5;

// 答弁網羅性の色（高=緑, 中=黄, 低=赤）
const completenessColor = completeness >= 0.7 ? '#16a34a' : completeness >= 0.4 ? '#d97706' : '#dc2626';
const completenessLabel = completeness >= 0.7 ? '高' : completeness >= 0.4 ? '中' : '低';

// コミット強度ラベル
function commitLabel(s: number): string {
  if (s === 0) return '';
  if (s < 0.2) return '検討';
  if (s < 0.5) return '弱';
  if (s < 0.7) return '中';
  if (s < 0.9) return '強';
  return '即時';
}
const commitLabelText = commitLabel(commitStrength);

// 5段階ドット表示（例: ●●●○○）
function dots(score: number): string {
  const filled = Math.round(score * 5);
  return '●'.repeat(filled) + '○'.repeat(5 - filled);
}

// 議事録価値の星表示
function stars(score: number): string {
  const filled = Math.round(score * 5);
  return '★'.repeat(filled) + '☆'.repeat(5 - filled);
}

// 動画タイムスタンプを "M:SS〜" 形式に変換
function formatVideoTime(videoUrl: string): string | null {
  const shugiinMatch = videoUrl.match(/[?&]time=(\d+)/);
  const sangiinMatch = videoUrl.match(/#(\d+)$/);
  const seconds = shugiinMatch
    ? parseInt(shugiinMatch[1], 10)
    : sangiinMatch
      ? parseInt(sangiinMatch[1], 10)
      : null;
  if (seconds === null) return null;
  const m = Math.floor(seconds / 60);
  const s = seconds % 60;
  return `${m}:${String(s).padStart(2, '0')}〜`;
}

const videoTime = pair.video_url ? formatVideoTime(pair.video_url) : null;

/** 箇条書き（"- " 始まり行）をHTMLリストに変換。非箇条書きはそのまま返す */
function formatSummary(text: string): { isList: boolean; items: string[] } {
  const lines = text.split('\n').filter(l => l.trim());
  const isList = lines.length > 1 && lines.every(l => l.trim().startsWith('- '));
  if (isList) {
    return { isList: true, items: lines.map(l => l.trim().replace(/^- /, '')) };
  }
  return { isList: false, items: [text] };
}

const qSummary = formatSummary(pair.question.summary);
const aSummary = formatSummary(pair.answer.summary);
const videoTitle = videoTime ? `動画を見る（${videoTime}）` : '動画を見る';
const chamberName = session?.chamber === 'shugiin' ? '衆議院TV' : session?.chamber === 'sangiin' ? '参議院TV' : null;
---
<div
  class="qa-card"
  id={`qa-${pair.id}`}
  data-pagefind-body
  data-pagefind-meta={`title:[Q&A] ${pair.question.speaker} → ${pair.answer.speaker}: ${pair.topic}`}
>
  <div class="qa-header">
    <span class="topic">{pair.topic}</span>
    <div class="header-right">
      <span class="record-value" title={`議事録価値: この質疑で議事録に残る新事実・解釈・前進があるか（${(recordVal * 100).toFixed(0)}%）`}>
        📋 {stars(recordVal)}
      </span>
      {pair.video_url && (
        <a
          class="video-link"
          href={pair.video_url}
          target="_blank"
          rel="noopener noreferrer"
          title={videoTitle}
        >
          ▶ 動画{videoTime ? `（${videoTime}）` : ''}
        </a>
      )}
    </div>
  </div>

  <div class="qa-columns">
    <div class="question">
      <div class="speaker-label">
        質問 — <strong>{pair.question.speaker}</strong>
        {pair.question.party && <span class="party">（{pair.question.party}）</span>}
      </div>
      {qSummary.isList ? (
        <ul class="summary-list">
          {qSummary.items.map(item => <li>{item}</li>)}
        </ul>
      ) : (
        <p class="summary">{pair.question.summary}</p>
      )}
      {pair.question.full_text && (
        <details class="full-text-details">
          <summary class="expand-toggle">{segmentDup ? 'セグメント全文を表示' : '全文を表示'}</summary>
          <div class="full-text">
            {pair.question.full_text.split(/(?<=。)/).filter((s: string) => s.trim()).map((para: string) => (
              <p>{para}</p>
            ))}
          </div>
        </details>
      )}
      <div class="q-metrics">
        <span
          class="metric-tag"
          title={`質問の鋭さ: 一問一答で答えられるか、次のアクションを迫る精度（${(qSharpness * 100).toFixed(0)}%）`}
        >
          精度 {dots(qSharpness)}
        </span>
        <span
          class="metric-tag"
          title={`根拠品質: 1次ソース・統計・過去答弁への言及度（${(evGrounding * 100).toFixed(0)}%）`}
        >
          根拠 {dots(evGrounding)}
        </span>
      </div>
    </div>

    <div class="answer">
      <div class="speaker-label">
        答弁 — <strong>{pair.answer.speaker}</strong>
        {pair.answer.role && <span class="role">（{pair.answer.role}）</span>}
      </div>
      {aSummary.isList ? (
        <ul class="summary-list">
          {aSummary.items.map(item => <li>{item}</li>)}
        </ul>
      ) : (
        <p class="summary">{pair.answer.summary}</p>
      )}
      {pair.answer.full_text && (
        <details class="full-text-details">
          <summary class="expand-toggle">{segmentDup ? 'セグメント全文を表示' : '全文を表示'}</summary>
          <div class="full-text">
            {pair.answer.full_text.split(/(?<=。)/).filter((s: string) => s.trim()).map((para: string) => (
              <p>{para}</p>
            ))}
          </div>
        </details>
      )}
      <div class="a-metrics">
        <span
          class="completeness"
          style={`color: ${completenessColor}`}
          title={`答弁網羅性: 質問の全論点を具体的に答えたか（${(completeness * 100).toFixed(0)}%）`}
        >
          網羅性 {completenessLabel}（{(completeness * 100).toFixed(0)}%）
        </span>
        {commitStrength > 0 && commitLabelText && (
          <span class="commit-tag" title={`コミット強度: 約束の具体性・拘束力（${(commitStrength * 100).toFixed(0)}%）`}>
            コミット {commitLabelText}
          </span>
        )}
      </div>
      {pair.answer.commitment_text && commitStrength > 0 && (
        <div class="commitment">
          <span class="commitment-label">約束:</span> {pair.answer.commitment_text}
        </div>
      )}
    </div>
  </div>

  {session && chamberName && (
    <div class="qa-source">
      出典:{' '}
      <a
        href={session.source_url}
        target="_blank"
        rel="noopener noreferrer"
        class="source-link"
      >
        {chamberName}インターネット審議中継
      </a>
    </div>
  )}
</div>

<style>
  .qa-card {
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    background: #fff;
    margin-bottom: 1rem;
    overflow: hidden;
  }
  .qa-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 1rem;
    background: #f8fafc;
    border-bottom: 1px solid #e5e7eb;
    font-size: 0.85rem;
    gap: 0.5rem;
  }
  .topic {
    font-weight: 600;
    color: #374151;
    flex: 1;
    min-width: 0;
  }
  .header-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }
  .record-value {
    font-size: 0.75rem;
    color: #92400e;
    cursor: default;
    white-space: nowrap;
  }
  .video-link {
    color: #2563eb;
    text-decoration: none;
    font-size: 0.8rem;
    white-space: nowrap;
  }
  .video-link:hover { text-decoration: underline; }
  .qa-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
  }
  @media (max-width: 640px) {
    .qa-columns { grid-template-columns: 1fr; }
  }
  .question, .answer {
    padding: 1rem;
  }
  .question {
    border-right: 1px solid #e5e7eb;
  }
  @media (max-width: 640px) {
    .question {
      border-right: none;
      border-bottom: 1px solid #e5e7eb;
    }
  }
  .speaker-label {
    font-size: 0.85rem;
    color: #6b7280;
    margin-bottom: 0.4rem;
  }
  .speaker-label strong { color: #111; }
  .party, .role { color: #6b7280; }
  .summary {
    margin: 0 0 0.5rem;
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .summary-list {
    margin: 0 0 0.5rem;
    padding-left: 1.2rem;
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .summary-list li {
    margin-bottom: 0.15rem;
  }
  /* 質問指標バッジ */
  .q-metrics {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.5rem;
    flex-wrap: wrap;
  }
  .metric-tag {
    font-size: 0.72rem;
    color: #4b5563;
    background: #f3f4f6;
    border-radius: 4px;
    padding: 0.15rem 0.4rem;
    cursor: default;
    white-space: nowrap;
    letter-spacing: -0.02em;
  }
  /* 答弁指標 */
  .a-metrics {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    flex-wrap: wrap;
  }
  .completeness {
    font-size: 0.8rem;
    font-weight: 600;
    cursor: default;
  }
  .commit-tag {
    font-size: 0.72rem;
    font-weight: 600;
    background: #ecfdf5;
    color: #065f46;
    border: 1px solid #6ee7b7;
    border-radius: 4px;
    padding: 0.1rem 0.4rem;
    cursor: default;
  }
  .commitment {
    font-size: 0.8rem;
    background: #f0fdf4;
    border-left: 3px solid #16a34a;
    padding: 0.4rem 0.6rem;
    margin-top: 0.4rem;
    color: #166534;
    line-height: 1.4;
  }
  .commitment-label { font-weight: 600; }
  .full-text-details {
    margin-top: 0.5rem;
  }
  .expand-toggle {
    font-size: 0.8rem;
    color: #2563eb;
    cursor: pointer;
    user-select: none;
  }
  .expand-toggle:hover {
    text-decoration: underline;
  }
  .full-text {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
    line-height: 1.7;
    color: #374151;
    background: #f9fafb;
    padding: 0.75rem;
    border-radius: 4px;
    border: 1px solid #e5e7eb;
  }
  .full-text p {
    margin: 0 0 0.5rem;
    text-indent: 1em;
  }
  .full-text p:last-child { margin-bottom: 0; }
  .qa-source {
    padding: 0.4rem 1rem;
    background: #f8fafc;
    border-top: 1px solid #e5e7eb;
    font-size: 0.75rem;
    color: #9ca3af;
  }
  .source-link {
    color: #9ca3af;
    text-decoration: none;
  }
  .source-link:hover {
    text-decoration: underline;
    color: #6b7280;
  }
</style>
